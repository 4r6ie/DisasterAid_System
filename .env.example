# Root environment used by Docker Compose.
# The Laravel application itself reads backend/.env.

APP_PORT=8000
DB_PORT=5432
DB_DATABASE=disasteraid
DB_USERNAME=disasteraid
DB_PASSWORD=disasteraid

# Seeded administrator account (used by backend/database/seeders/AdminUserSeeder.php)
ADMIN_EMAIL=admin@disasteraid.test
ADMIN_PASSWORD=password
